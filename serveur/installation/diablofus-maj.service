# /etc/systemd/system/diablofus-maj.service : lance /home/diablofus/maj.sh (voir diablofus-maj.timer).
[Unit]
Description=Diablofus : mise à jour depuis GitHub
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=diablofus
Group=diablofus
ExecStart=/bin/bash /home/diablofus/maj.sh
MemoryMax=512M
CPUQuota=50%
OOMScoreAdjust=500
